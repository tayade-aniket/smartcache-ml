# SmartCache ML Configuration

# Cache Settings
CACHE_DB_PATH=data/cache.db
SIMILARITY_THRESHOLD=0.85
MAX_CACHE_SIZE=1000
CACHE_TTL_SECONDS=86400

# Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# LLM Provider Configuration ('mock' or 'ollama')
LLM_PROVIDER=mock

# Ollama Settings (Optional, when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_SMALL_MODEL=llama3.2:1b
OLLAMA_LARGE_MODEL=llama3.2:3b

# Estimated Token Pricing for Tracking (USD per 1k tokens)
PRICE_PER_1K_INPUT_TOKENS_SMALL=0.00015
PRICE_PER_1K_OUTPUT_TOKENS_SMALL=0.0006
PRICE_PER_1K_INPUT_TOKENS_LARGE=0.0015
PRICE_PER_1K_OUTPUT_TOKENS_LARGE=0.006

# API Settings
API_HOST=127.0.0.1
API_PORT=8000
